# ============================================================================
#  Aegis.0G client (Vite) environment template
# ============================================================================

# Which 0G network the dapp targets (mainnet | testnet)
VITE_NETWORK=testnet

# Custom RPCs (optional — falls back to public defaults)
VITE_ZG_MAINNET_RPC=https://evmrpc.0g.ai
VITE_ZG_TESTNET_RPC=https://evmrpc-testnet.0g.ai

# Block explorer for tx/address links
VITE_EXPLORER_BASE=https://chainscan-galileo.0g.ai
# For mainnet: https://chainscan.0g.ai

# Deployed contract addresses (output of contracts/scripts/deploy.js)
VITE_AUSDC_ADDRESS=
VITE_AEGIS_VAULT_ADDRESS=

# Backend API
VITE_API_BASE_URL=http://localhost:3001

# WalletConnect (RainbowKit) — get one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=
